generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  googleId           String?   @unique
  name               String
  role               String?
  teamSize           String?
  intent             String?
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  lastActiveAt       DateTime  @default(now())
  projects           Project[]
}

model Project {
  id          String    @id @default(uuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  title       String    @default("Untitled Project")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  versions    Version[]

  @@index([ownerId])
}

model Version {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  versionNumber Int
  createdAt     DateTime @default(now())
  nodes         Node[]
  edges         Edge[]
  risks         Risk[]

  @@unique([projectId, versionNumber])
}

model Node {
  id        String  @id @default(uuid())
  versionId String
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  nodeKey   String
  label     String
  type      String
  x         Float
  y         Float
  metadata  Json

  @@index([versionId])
}

model Edge {
  id        String  @id @default(uuid())
  versionId String
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  edgeKey   String
  source    String
  target    String
  metadata  Json

  @@index([versionId])
}

model Risk {
  id          String  @id @default(uuid())
  versionId   String
  version     Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  nodeKey     String?
  severity    String?
  description String

  @@index([versionId])
}
